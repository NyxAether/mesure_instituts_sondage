  "chart": {
    "$comment": "Séries validées avec tools/validate_palette.js (CVD ΔE ≥ 10, contraste ≥ 3:1). Ordre fixe, jamais cyclé. Rampes séquentielles (prune, crépuscule) : de la plus faible à la plus forte valeur, contrôle ordinal sur les trois fonds ; le pas 3 du thème clair est la série. Divergente : crépuscule (−) ↔ mark-muted ↔ prune (+), tirée des rampes (pas 4 et 2).",
    "light": {
      "surface": "#EEF0E8",
      "grid": "#D9DED1",
      "axis": "#A9B0A1",
      "mark-muted": "#BFC6B6",
      "mark-ink": "#6F736A",
      "series": ["#9E5468", "#4670A8", "#854F14", "#8368A8", "#1A653A"],
      "sequential": {
        "prune": ["#C58292", "#B26B7D", "#9E5568", "#814152", "#652E3D"],
        "dusk": ["#759BCD", "#5D85BB", "#4770A7", "#34598A", "#23436D"]
      },
      "diverging": ["#34598A", "#5D85BB", "#BFC6B6", "#B26B7D", "#814152"]
    },
    "dark": {
      "surface": "#242A24",
      "grid": "#313831",
      "axis": "#4A534A",
      "mark-muted": "#4F584F",
      "mark-ink": "#8F948B",
      "series": ["#BA5F78", "#5E97CD", "#B98749", "#9E83C5", "#3F936E"],
      "sequential": {
        "prune": ["#8B3D54", "#AC546C", "#C57288", "#DE91A4", "#F6B1C1"],
        "dusk": ["#2C5E8C", "#4179AC", "#6294C4", "#83B0DB", "#A4CCF3"]
      },
      "diverging": ["#83B0DB", "#4179AC", "#4F584F", "#AC546C", "#DE91A4"]
    },
    "series-names": ["prune", "crépuscule", "ocre", "ardoise", "sauge"],
    "area-opacity": 0.15
  },
  "video": {
    "$comment": "Vidéo 1920×1080 (guide/video.md). Tailles en px de l'image, durées en secondes, courbe motion.ease.",
    "size": [1920, 1080],
    "fps": 60,
    "margin": { "x": 75, "top": 58 },
    "header": {
      "$comment": "En-tête compact des plans de contenu : tag mono « // 0N · nom » au-dessus du titre, ligne facultative dessous (source, précision). title-max : longueur du titre en caractères.",
      "tag": 24,
      "title": 56,
      "gap": 14,
      "title-max": 40,
      "subtitle": { "size": 24, "gap": 14 },
      "enter": {
        "$comment": "top : haut du bloc agrandi, en fraction de la hauteur ; le bloc garde margin.x (origine en haut à gauche).",
        "fade-in": 0.4, "scale": 1.9, "top": 0.38, "hold": 1.4, "move": 0.9, "content-delay": 0.5, "content-fade": 0.6
      }
    },
    "chapter": {
      "$comment": "Écran de chapitre « sommaire » : compteur qui suit le curseur, liste, sélection, titre tapé. list.top : haut de la boîte de la ligne (interligne 1).",
      "counter": { "size": 403, "x": 125, "travel": 0.3 },
      "list": { "x": 845, "top": 250, "size": 31, "pitch": 53, "rise": 15 },
      "cursor-x": 799,
      "band": { "x": 783, "width": 576, "height": 50, "scale-from": 0.96 },
      "title": {
        "$comment": "offset : haut du titre sous le haut de la ligne suivante, avant ouverture. cursor : curseur bloc en em du titre.",
        "size": 71, "x": 919, "opening": 123, "offset": 2,
        "cursor": { "width": 0.55, "height": 1, "gap": 0.15 }
      },
      "timing": {
        "$comment": "Le déplacement du curseur finit à chaque pas : il se pose sur la ligne N à cursor + (N − 1) × step.",
        "row-stagger": 0.08, "row-fade": 0.35, "cursor": 0.9, "cursor-fade": 0.2, "step": 0.5, "move": 0.28,
        "select-after": 0.45, "band-fade": 0.18, "open-after": 0.15, "open": 0.4, "type-after": 0.1, "char": 0.055,
        "blink": 1.0, "hold": 1.5, "exit": 0.4
      }
    },
    "chart-label": 24
  },
  "font": {
    "serif": { "family": "Newsreader", "stack": "'Newsreader', 'Iowan Old Style', Georgia, serif" },
    "sans": { "family": "Inter", "stack": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
    "mono": { "family": "JetBrains Mono", "stack": "'JetBrains Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace" },
    "google": "https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;700&display=swap"
  },
  "type-scale": {
    "$comment": "rem, ratio 1,2 (tierce mineure) à partir de 1rem. Les titres display (hero) restent en clamp().",
    "xs": "0.72rem",
    "sm": "0.83rem",
    "base": "1rem",
    "md": "1.2rem",
    "lg": "1.44rem",
    "xl": "1.73rem",
    "2xl": "2.07rem",
    "3xl": "2.49rem",
    "display": "clamp(2.2rem, 5vw, 3.4rem)",
    "hero": "clamp(3.5rem, 9vw, 7.5rem)"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "14": "56px", "16": "64px", "20": "80px", "30": "120px" },
  "radius": { "sm": "2px", "md": "4px", "lg": "6px" },
  "motion": {
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "fast": "0.2s",
    "smooth": "0.4s",
    "reveal": "0.6s",
    "modal": "0.25s"
  },
  "layout": { "container": "1200px", "prose": "800px", "nav-height": "64px", "gutter": "24px" }
}
