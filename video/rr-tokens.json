    "base": "1rem",
    "md": "1.2rem",
    "lg": "1.44rem",
    "xl": "1.73rem",
    "2xl": "2.07rem",
    "3xl": "2.49rem",
    "display": "clamp(2.2rem, 5vw, 3.4rem)",
    "hero": "clamp(3.5rem, 9vw, 7.5rem)"
