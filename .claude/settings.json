{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-before-commit.sh\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Vérification de la review pre-commit"
          }
        ]
      }
    ]
  }
}
